    "persist_exact_response_before_handling": true,
    "rewrite_after_response": false,
    "validator_can_block": false,
    "validator_can_trigger_call": false,
    "prior_read_can_replace_new_response": false,
    "malformed_but_usable_prose_remains_visible": true,
    "no_response_transport_failure": "record_failure_without_unauthorized_second_call"
  },
  "language_layer_contains": [
