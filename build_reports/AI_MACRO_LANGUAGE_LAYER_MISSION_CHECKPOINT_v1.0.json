    "owner_action_or_approved_schedule_authorizes_generation",
    "deterministic_platform_builds_current_evidence_bundle",
    "platform_loads_versioned_language_layer",
    "request_composer_combines_evidence_language_layer_and_output_contract",
    "one_openai_api_call_generates_all_domain_and_macro_reads",
    "exact_response_is_persisted_before_parsing_or_diagnostics",
    "structure_is_parsed_without_changing_returned_text",
    "exact_returned_prose_is_published",
    "optional_diagnostics_are_attached_separately"
  ],
  "paid_call_contract": {
    "calls_per_authorized_generation": 1,
    "sdk_retries": 0,
    "editor_calls": 0,
    "critic_calls": 0,
    "repair_calls": 0,
    "replacement_calls": 0,
    "validation_triggered_calls": 0,
    "fallback_generation_calls": 0
  },
  "publication_contract": {
