  "provisional_universal_hypotheses": [
    {
      "hypothesis_id": "CON-U01",
      "label": "Visible infrastructure versus effective interconnection",
      "proposition": "Public registries and membership lists may understate private, bilateral, remote or indirect interconnection, so observed infrastructure is a lower-bound view of effective connectivity.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U02",
      "label": "Physical route versus logical path",
      "proposition": "IP paths cannot be mapped to physical terrestrial or submarine routes without cross-layer inference and explicit uncertainty.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U03",
      "label": "National route totals versus local usable capacity",
      "proposition": "A national cable, route or facility count does not establish bandwidth, port availability, latency, redundancy or commercial access at a specific campus.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U04",
      "label": "Geographic proximity versus path locality",
      "proposition": "Geographically local endpoints may traverse distant networks because topology, peering policy and economics mediate route choice.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U05",
      "label": "Route count versus independent resilience",
      "proposition": "Multiple apparent routes can share landing stations, conduits, hazards, providers or repair dependencies and therefore need not provide independent redundancy.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U06",
      "label": "Interconnection realization ladder",
      "proposition": "Facility or IXP presence must be separated from physical access, provisioning, peering agreement, route exchange, carried traffic and realized performance.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U07",
      "label": "Conditional capacity and performance",
      "proposition": "Connectivity performance is conditional on topology, routing policy, congestion, time, measurement point and failure regime.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U08",
      "label": "Availability versus adoption and use",
      "proposition": "Public or municipal infrastructure availability does not guarantee institutional adoption, affordable service or realized traffic.",
      "status": "PROVISIONAL_UNTESTED"
    },
    {
      "hypothesis_id": "CON-U09",
      "label": "Membership versus dependency footprint",
      "proposition": "Reported IXP membership is not equivalent to the set of networks, customers or traffic flows that depend directly or indirectly on the exchange.",
      "status": "PROVISIONAL_UNTESTED"
    }
  ],
