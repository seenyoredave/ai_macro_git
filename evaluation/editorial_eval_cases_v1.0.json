{
  "schema_version": "1.0",
  "suite_version": "1.0.0",
  "purpose": "Blind, production-shaped evaluation cases for the one-call AI Macro editorial synthesis pipeline.",
  "rubric": {
    "dimensions": ["factual_fidelity", "coherence", "relevance", "readability", "material_usefulness"],
    "score_range": [1, 5],
    "publish_without_edit_target": 0.8,
    "paired_distinction_target": 0.9,
    "unsupported_numeric_claims_allowed": 0,
    "median_dimension_score_target": 4
  },
  "cases": [
    {
      "case_id": "MKT-BROAD-01",
      "pair_id": "MKT-COMPOSITION",
      "category": "market_composition",
      "expected_decision": "publish",
      "setup": "AEI rises by the same amount as its pair, with gains distributed across sectors and firms.",
      "signals": ["AEI +3.6", "positive breadth rises", "median and equal-weight returns improve", "top-ten share falls"],
      "must_address": ["broadening participation", "concentration is easing"],
      "must_not_claim": ["economy-wide adoption", "causation"]
    },
    {
      "case_id": "MKT-NARROW-02",
      "pair_id": "MKT-COMPOSITION",
      "category": "market_composition",
      "expected_decision": "publish",
      "setup": "AEI rises by the same amount as its pair, but breadth weakens and gains concentrate in the largest firms.",
      "signals": ["AEI +3.6", "positive breadth falls", "median return weakens", "top-ten share rises"],
      "must_address": ["narrow leadership", "aggregate strength masks concentration"],
      "must_not_claim": ["broad market confirmation", "causation"]
    },
    {
      "case_id": "FIN-FUNDED-03",
      "pair_id": "FIN-FUNDING",
      "category": "finance",
      "expected_decision": "publish",
      "setup": "Forward commitments rise while operating cash flow and cash reserves improve.",
      "signals": ["commitment load rises", "internal funding coverage above one", "cash runway improves", "borrower strain stable"],
      "must_address": ["commitments are large but presently fundable", "timing remains relevant"],
      "must_not_claim": ["commitments are realized returns"]
    },
    {
      "case_id": "FIN-STRAINED-04",
      "pair_id": "FIN-FUNDING",
      "category": "finance",
      "expected_decision": "publish",
      "setup": "Forward commitments rise by the same amount as its pair while cash coverage deteriorates and borrower strain increases.",
      "signals": ["commitment load rises", "internal funding coverage below one", "cash runway falls", "borrower strain rises"],
      "must_address": ["funding burden", "refinancing or external capital dependence"],
      "must_not_claim": ["default is certain"]
    },
    {
      "case_id": "PWR-DELIVERED-05",
      "pair_id": "POWER-STATE",
      "category": "power",
      "expected_decision": "publish",
      "setup": "Generation capacity increases with operating evidence and adequate reserve conditions.",
      "signals": ["operating supply rises", "reserve margin remains positive", "large-load campus capacity rises", "queue conversion improves"],
      "must_address": ["delivered power supports deployment", "conversion evidence matters"],
      "must_not_claim": ["every campus is energized"]
    },
    {
      "case_id": "PWR-PLANNED-06",
      "pair_id": "POWER-STATE",
      "category": "power",
      "expected_decision": "publish",
      "setup": "The same capacity increase exists only in planned additions while reserve stress and queue attrition worsen.",
      "signals": ["planned additions rise", "reserve margin turns negative", "large-load campus capacity rises", "queue withdrawals rise"],
      "must_address": ["plans are not delivered supply", "deliverability bottleneck"],
      "must_not_claim": ["planned capacity is operating"]
    },
    {
      "case_id": "ADP-BROAD-07",
      "pair_id": "ADOPTION-DEPTH",
      "category": "adoption",
      "expected_decision": "publish",
      "setup": "Business AI use rises with broader functional deployment and organizational adjustment.",
      "signals": ["current business use rises", "use across more than three functions rises", "organizational change rises", "task creation rises"],
      "must_address": ["diffusion is deepening", "organizational absorption"],
      "must_not_claim": ["productivity causation"]
